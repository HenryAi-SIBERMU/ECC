# ---------------------------------------------------------
# DATA PREPARATION (PURE DATA-DRIVEN)
# ---------------------------------------------------------
@st.cache_data
def load_logistik():
    base_dir = os.path.dirname(os.path.dirname(__file__))
    return pd.read_csv(os.path.join(base_dir, "data", "processed", "sulawesi_logistik_simpul_nikel.csv"))

df = load_logistik()

n_lokasi = len(df)
n_mandiri = len(df[df["port_facility"] == "terkonfirmasi"])
n_berbagi = len(df[df["port_facility"] == "terkonfirmasi_berbagi"])
n_psn = len(df[df["psn_status"] == "terkonfirmasi"])
total_pltu = int(df["pltu_mw"].sum())
total_izin = int(df["izin_nikel_count"].sum())

