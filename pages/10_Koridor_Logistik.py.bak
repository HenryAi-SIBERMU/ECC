            pltu_val = int(r["pltu_mw"]) if pd.notna(r["pltu_mw"]) else 0
            izin_val = int(r["izin_nikel_count"]) if pd.notna(r["izin_nikel_count"]) else 0
            port_status = str(r["port_facility"]).replace("_", " ").title()
            psn_status = str(r["psn_status"]).replace("_", " ").title()

            m1, m2, m3, m4 = st.columns(4)
