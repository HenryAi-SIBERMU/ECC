            {info['narrative']}
            </div>
            """, unsafe_allow_html=True)

            fc1, fc2 = st.columns(2)
            with fc1:
                st.markdown("**Fakta Kunci:**")
                for fact in info["key_facts"]:
                    st.markdown(f"- {fact}")
            with fc2:
                st.markdown("**Detail Dermaga:**")
