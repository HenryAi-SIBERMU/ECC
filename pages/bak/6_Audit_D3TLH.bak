                ])
                df_pltu_op_tab = pd.concat([df_pltu_op_tab, grid_pltu], ignore_index=True)
                
                panel_data_pltu = []
                for y in years:
                    for prov in prov_map.values():
                        cap = df_pltu_op_tab[(df_pltu_op_tab['Provinsi'] == prov) & (df_pltu_op_tab['Start year'] <= y)]['Capacity (MW)'].sum()
